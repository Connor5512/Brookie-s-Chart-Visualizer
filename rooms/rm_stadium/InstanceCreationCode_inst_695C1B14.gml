click_script = scr_button_generalized_info;

info_text = "\"Four Elements\" is the theme for the 2026-2027 Sylvania Southview Marching Band.\n\n- Parts 1 and 3 have written tempo changes that this visualizer cannot be updated to account for.\n- Parts 3 and 4 have written time signature changes that this visualizer cannot be updated to account for.";