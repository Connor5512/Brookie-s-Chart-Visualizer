click_script = scr_button_generalized_info;

info_text = "Color marchers -\n\nChanges the appearance of marchers to match their instrument.\n" +

"Instruments are decided by the marcher's \"instrument\" attribute.\n\n" + 

"Flute - blue\nClarinet - green\nSaxophones - yellow\nTrumpet - red\nHorn - teal\nTrombone - purple\nBaritone - dark magenta\nTuba - dark purple\nBattery Percussion - royal blue";